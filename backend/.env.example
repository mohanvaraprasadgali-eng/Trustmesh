# TrustMesh Backend — Environment Variables
# Copy this to .env and fill in real values

# MST Blockchain Configuration
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=4545

# Backend wallet private key (testnet wallet only)
# This wallet signs transactions on behalf of the backend
# Fund it with tMSTC from: https://faucet.masterstroke.academy
BACKEND_WALLET_PRIVATE_KEY=your_testnet_private_key_here

# Smart Contract Addresses (fill after deployment)
AGENT_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
TASK_ESCROW_ADDRESS=

# Database
DATABASE_URL=sqlite:///./trustmesh.db

# CORS allowed origins (frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
