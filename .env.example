# TrustMesh — Environment Variables Example
# Copy this file to .env and fill in real values
# NEVER commit the actual .env file

# ============================================
# MST BLOCKCHAIN / DEPLOYMENT
# ============================================

# Your deployer wallet private key (for contract deployment only)
# Get a test wallet from BridgeKey — use testnet ONLY
PRIVATE_KEY=your_private_key_here

# MST Testnet RPC
MST_RPC_URL=https://testnetrpc.mstblockchain.com

# MST Chain ID (91562037 reported by live testnet RPC, 4545 legacy)
MST_CHAIN_ID=91562037

# ============================================
# SMART CONTRACT ADDRESSES
# (Fill after deploying to MST Testnet or Local Hardhat)
# ============================================
AGENT_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
TASK_ESCROW_ADDRESS=

# ============================================
# BACKEND CONFIGURATION
# ============================================

# FastAPI backend URL (when running locally)
BACKEND_URL=http://localhost:8000

# Backend wallet (for signing blockchain transactions from backend)
# Use a separate funded testnet wallet — NOT the same as deployer
BACKEND_WALLET_PRIVATE_KEY=your_backend_wallet_private_key_here

# ============================================
# FRONTEND (Next.js) — prefix with NEXT_PUBLIC_
# ============================================
# Mode: "LOCAL_DEMO" or "MST_TESTNET"
NEXT_PUBLIC_ENVIRONMENT=LOCAL_DEMO
NEXT_PUBLIC_MST_RPC_URL=https://testnetrpc.mstblockchain.com
NEXT_PUBLIC_MST_CHAIN_ID=91562037
NEXT_PUBLIC_MSTSCAN_URL=https://mstscan.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Contract addresses for frontend
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_TASK_ESCROW_ADDRESS=
