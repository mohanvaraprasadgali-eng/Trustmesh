# ===========================
# TrustMesh — .gitignore
# ===========================

# Environment variables (NEVER commit these)
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Hardhat
cache/
artifacts/
typechain-types/

# Next.js
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/

# Python
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/venv/
backend/.venv/
backend/*.egg-info/
backend/dist/
backend/.pytest_cache/

# Database (SQLite — can regenerate)
backend/*.db
backend/*.sqlite

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Keys (CRITICAL — never commit)
*.pem
*.key
*.p12
keystore/
